# Required in production (any long random string).
JWT_SECRET=
NODE_ENV=production
PORT=8080
DB_PATH=data/app.db

# Enables the simulator and one-tap demo logins. Set to false for a real pilot.
DEMO_MODE=true

# Only needed when the client is served from a different origin (comma-separated).
CORS_ORIGIN=http://localhost:5173

# Alert tuning (defaults from the blueprint).
ALERT_DISTANCE_M=500
ALERT_ETA_S=60
ESCALATE_AFTER_MS=10000

# Assumption behind the clearly labeled "simulated time saved" figure.
ASSUMED_WAIT_PER_JUNCTION_S=45

LOG_LEVEL=info
